<Window x:Class="KwantDesk.Workstation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:KwantDesk.Rendering;assembly=KwantDesk.Rendering"
        Title="KwantDesk Workstation"
        Width="1500"
        Height="920"
        MinWidth="960"
        MinHeight="600"
        Background="#050607"
        Foreground="#F4F6F8"
        FontFamily="Bahnschrift"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#080A0C" />
            <Setter Property="Foreground" Value="#9DA7B1" />
            <Setter Property="BorderBrush" Value="#22282E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#B5FF00" />
                    <Setter Property="BorderBrush" Value="#4C6300" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#030405" BorderBrush="#1B2025" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" Background="#B5FF00" Margin="0,0,10,0">
                        <TextBlock Text="K" Foreground="#050607" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="KWANT DESK" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopButton}" Content="CHARTS" Foreground="#B5FF00" />
                    <Button Style="{StaticResource TopButton}" Content="GEX VUE" />
                    <Button Style="{StaticResource TopButton}" Content="GEX MAP" />
                    <Button Style="{StaticResource TopButton}" Content="LIQ MAP" />
                    <Button Style="{StaticResource TopButton}" Content="TRADE" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ConnectionBadge" Height="30" Padding="12,0" BorderBrush="#343A40" BorderThickness="1" CornerRadius="2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#606A73" Margin="0,0,8,0" />
                            <TextBlock x:Name="ConnectionText" Text="OFFLINE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#07090B" BorderBrush="#1B2025" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NQ" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  E-MINI NASDAQ-100  ·  CME" Foreground="#69737D" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopButton}" Content="1m" Foreground="#B5FF00" MinWidth="46" />
                    <Button Style="{StaticResource TopButton}" Content="5m" MinWidth="46" />
                    <Button Style="{StaticResource TopButton}" Content="15m" MinWidth="46" />
                    <Button Style="{StaticResource TopButton}" Content="1h" MinWidth="46" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LiveButton" Style="{StaticResource TopButton}" Content="GO LIVE" Click="LiveButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <rendering:KwantChartControl x:Name="Chart" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,7"
                    Background="#D9030506" BorderBrush="#242A30" BorderThickness="1" CornerRadius="2"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NQ" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="  1 MIN  ·  GPU NATIVE" Foreground="#68727C" FontSize="10" Margin="4,1,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#030405" BorderBrush="#1B2025" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusDetail" Text="Native workstation initializing" Foreground="#69737D" FontSize="10" VerticalAlignment="Center" />
                <TextBlock x:Name="HeartbeatText" HorizontalAlignment="Right" Foreground="#69737D" FontSize="10" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
