# Copy these into Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the newer publishable key if Supabase provides one, otherwise use the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Comma-separated allowlist. Only these Google accounts can access the dashboard.
ALLOWED_EMAILS=your-gmail@gmail.com
# Server-only key used for CME futures and options market data.
DATABENTO_API_KEY=db-your-server-only-key
# Server-only credentials for the private full-depth heatmap gateway.
KWANTIFY_MARKET_DATA_GATEWAY_URL=https://your-private-market-data-gateway
KWANTIFY_MARKET_DATA_GATEWAY_TOKEN=your-private-gateway-token
KWANTIFY_MARKET_DATA_PROVIDER=Databento
# Server-only key used for intelligent Kwant Bot replies.
ANTHROPIC_API_KEY=sk-ant-your-server-only-key
# Optional model override. The application defaults to Claude Sonnet 4.6.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Used to create OAuth redirect URLs in production.
NEXT_PUBLIC_SITE_URL=https://www.kwantdesk.com
