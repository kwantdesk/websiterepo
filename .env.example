# Copy these into Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the newer publishable key if Supabase provides one, otherwise use the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Comma-separated allowlist. Only these Google accounts can access the dashboard.
ALLOWED_EMAILS=your-gmail@gmail.com
DATABENTO_API_KEY=db-your-server-only-key
# Used to create OAuth redirect URLs in production.
NEXT_PUBLIC_SITE_URL=https://www.kwantdesk.com
