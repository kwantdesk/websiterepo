# Copy these into Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the newer publishable key if Supabase provides one, otherwise use the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only key used for CME futures and options market data.
DATABENTO_API_KEY=db-your-server-only-key
# Server-only key used for exact Cboe VIX/VXN index history and snapshots.
MASSIVE_API_KEY=your-massive-api-key
# Server-only key used only for the live VIX spot snapshot.
GEXBOT_API_KEY=gexbot_custom_your-server-only-key
# Server-only key used by the QQQ/SPY gamma fallback and Gamma workspace.
QUANTDATA_API_KEY=qd-your-server-only-key
# Optional licensed long-range economic calendar. Without this, News uses the
# current-week backup calendar feed.
TRADING_ECONOMICS_API_KEY=your-trading-economics-key
# Server-only key used for intelligent KwantBot and ZYON replies.
ANTHROPIC_API_KEY=sk-ant-your-server-only-key
# Optional KwantBot-side-panel override. ZYON has an in-app model selector.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional override for the authenticated KwantBot self-review journal table.
KWANTBOT_LEARNING_TABLE=kwantbot_learning_reviews
# Used to create OAuth redirect URLs in production.
NEXT_PUBLIC_SITE_URL=https://www.kwantdesk.com
