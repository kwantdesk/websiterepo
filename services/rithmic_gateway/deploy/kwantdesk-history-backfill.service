[Unit]
Description=KwantDesk Rithmic History Plant candle backfill
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/srv/kwantdesk-recordings

[Service]
Type=exec
Restart=on-failure
RestartSec=60
TimeoutStopSec=45
ExecStart=/usr/bin/docker run --rm --name kwantdesk-history-bars --cpus 0.25 --memory 384m --log-opt max-size=10m --log-opt max-file=3 --env-file /opt/kwantify/rithmic_gateway/operator.env -e RITHMIC_RECORD_DIR=/recordings -e RITHMIC_HISTORY_FROM=2025-01-01 -e RITHMIC_HISTORY_WEEKLY_BUDGET_BYTES=38654705664 -v /srv/kwantdesk-recordings:/recordings kwantify-rithmic-gateway:local node scripts/run-history-bar-backfill.mjs
ExecStop=-/usr/bin/docker stop --time 30 kwantdesk-history-bars

[Install]
WantedBy=multi-user.target
